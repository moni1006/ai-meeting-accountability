# ── AI API Key (optional) ─────────────────────────────
# The app works in Mock AI mode without any key.
# To use a real AI API later, add your key here:
# OPENAI_API_KEY=your_openai_api_key_here

# ── Database ──────────────────────────────────────────
# SQLite database file path (default: backend/meeting_ai.db)
# DB_PATH=backend/meeting_ai.db

# ── Frontend ──────────────────────────────────────────
# Frontend API base URL (where the FastAPI backend runs)
# VITE_API_URL=http://localhost:8000
